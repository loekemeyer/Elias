<?xml version="1.0" encoding="UTF-8"?>
<!--
  Config de IIS. Hoy el sitio se publica por GitHub Pages, donde este archivo
  es inerte: se versiona para el dia que se sirva desde IIS.

  Sin el <staticContent> de abajo IIS devuelve 404 para toda extension que no
  tenga declarada, asi que `img/cart-icon.webp` y cualquier .woff2/.avif que se
  agregue no cargarian.

  OJO SI EL DESPLIEGUE A IIS USA ESPEJO (robocopy /MIR, rsync --delete): pisa
  el web.config del servidor con este. Con un copiado comun no pasa nada.

  NOTA: la seccion <rewrite> esta comentada porque requiere el modulo URL
  Rewrite de IIS; en hosting compartido (SolidCP, Plesk) rara vez esta
  instalado y su sola presencia provoca un 500. Si sabes que tu servidor lo
  tiene, descomentala para forzar HTTPS desde IIS.
  Lo mismo aplica a doDynamicCompression: necesita el modulo de compresion
  dinamica. Se deja solo doStaticCompression, que funciona en cualquier IIS 7+.
-->
<configuration>
  <system.webServer>

    <!-- HTTPS obligatorio (requiere modulo URL Rewrite — descomentar solo si
         el servidor lo tiene instalado)
    <rewrite>
      <rules>
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
    -->

    <!-- Tipos que IIS no conoce de fabrica -->
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <!-- Cache de un anio: los .js y .css llevan ?v=XXX, que lo invalida
           cuando cambian (ver hooks/pre-commit). -->
      <clientCache cacheControlMode="UseMaxAge"
                   cacheControlMaxAge="365.00:00:00" />
    </staticContent>

    <urlCompression doStaticCompression="true" />

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>

    <!-- Documento por defecto -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

  </system.webServer>
</configuration>
